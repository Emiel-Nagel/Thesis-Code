   "outputs": [],
   "source": [
    "start_scope()\n",
    "\n",
    "eqs = '''\n",
    "dv/dt = (I-v)/tau : 1\n",
    "I : 1\n",
    "tau : second\n",
    "'''\n",
    "group = NeuronGroup(\n",
    "    N=2,\n",
    "    model=eqs,\n",
    "    threshold='v>1',\n",
    "    reset='v = 0',\n",
    "    method='exact',\n",
    ")\n",
    "group.I = [2, 0]\n"
   ]
  }
